{% extends 'base.html.twig' %}

{% block title %} {% if event is not defined %} Modifier un événement {% else %} Créer un événement {% endif %}{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h1 class="h3 mb-4">Créer un événement</h1>

                        {{ form_start(form, {'attr': {'class': 'event-form'}}) }}

                        {% if errors is defined and errors is not empty %}
                            <div class="alert alert-danger">
                                <strong>Impossible de créer l'événement :</strong>
                                <ul class="mb-0 mt-1">
                                    {% for error in errors %}
                                        <li>{{ error }}</li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}

                        {# Affichage des erreurs globales #}
                        {{ form_errors(form) }}

                        <div class="form-group">
                            {{ form_label(form.title, 'Titre') }}
                            {{ form_widget(form.title, {'attr': {'class': 'form-control', 'placeholder': 'Ex : Meetup PHP Lyon'}}) }}
                            {{ form_errors(form.title) }}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.description, 'Description') }}
                            {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 5, 'placeholder': 'Décrivez votre événement…'}}) }}
                            {{ form_errors(form.description) }}
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group">
                                {{ form_label(form.startAt, 'Date de début') }}
                                {{ form_widget(form.startAt, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.startAt) }}
                            </div>
                            <div class="col-md-6 form-group">
                                {{ form_label(form.endAt, 'Date de fin') }}
                                {{ form_widget(form.endAt, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.endAt) }}
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group">
                                {{ form_label(form.capacity, 'Capacité (places)') }}
                                {{ form_widget(form.capacity, {'attr': {'class': 'form-control', 'min': 1}}) }}
                                {{ form_errors(form.capacity) }}
                            </div>
                            <div class="col-md-6 form-group">
                                {{ form_label(form.status, 'Statut') }}
                                {{ form_widget(form.status, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.status) }}
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group">
                                {{ form_label(form.category, 'Catégorie') }}
                                {{ form_widget(form.category, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.category) }}
                            </div>
                        </div>

                        {{ form_row(form.slug) }}

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a href="{{ path('all_events') }}" class="btn btn-link pl-0">Annuler</a>
                            {% if event is not defined %}
                                <button type="submit" class="btn btn-primary">Modifié l'événement</button>
                            {% else %}
                                <button type="submit" class="btn btn-primary">Créer l'événement</button>
                            {% endif %}
                        </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
