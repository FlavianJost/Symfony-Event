{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} | Tous les événements{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="mb-4">Tous les événements</h1>

        {% if events is empty %}
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center text-muted">
                    Aucun événement pour le moment.
                </div>
            </div>
        {% else %}
            <div class="row">
                {% for event in events %}
                    <div class="col-md-6 mb-4">
                        <div class="card border-0 shadow-sm h-100">
                            {% if event.coverImage %}
                                <img src="{{ event.coverImage }}" class="card-img-top" alt="{{ event.title }}">
                            {% endif %}
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title mb-0">{{ event.title }}</h5>
                                    <span class="badge badge-{% if event.status.value == 'published' %}success{% elseif event.status.value == 'cancelled' %}danger{% else %}secondary{% endif %}">
                                        {{ event.status.value }}
                                    </span>
                                </div>

                                {% if event.category %}
                                    <span class="badge badge-light border mb-2">{{ event.category.name }}</span>
                                {% endif %}

                                <p class="card-text text-muted mb-2">
                                    {{ event.description|length > 120 ? event.description|slice(0, 120) ~ '…' : event.description }}
                                </p>

                                <ul class="list-unstyled text-muted small mb-0">
                                    <li>🗓 {{ event.startAt|date('d/m/Y H:i') }} → {{ event.endAt|date('d/m/Y H:i') }}</li>
                                    <li>👥 {{ event.capacity }} places</li>
                                    {% if event.organizer %}
                                        <li>Organisé par {{ event.organizer.email }}</li>
                                    {% endif %}
                                </ul>
                                <a href="{{ path('event_show', {'slug': event.slug}) }}">Détails →</a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
