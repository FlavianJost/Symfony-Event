{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} | Homepage{% endblock %}

{% block body %}
    <div class="container mt-5">

        <div class="p-5 mb-5 bg-white rounded shadow-sm text-center">
            <h1 class="display-4 mb-3">
                🎉 Organisez. Participez. Partagez.
            </h1>

            <p class="lead text-muted mb-4">
                Créez des événements, gérez les inscriptions et simplifiez
                l'organisation de vos activités.
