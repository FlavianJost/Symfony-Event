{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}

    <div class="container py-5">

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <h1 class="mb-4">
                    Mon profil
                </h1>

                {% for message in app.flashes('success') %}
                    <div class="alert alert-success">
                        {{ message }}
                    </div>
                {% endfor %}

                {% for message in app.flashes('error') %}
                    <div class="alert alert-danger">
                        {{ message }}
                    </div>
                {% endfor %}

                <div class="card shadow-sm">

                    <div class="card-header">
                        Informations du compte
                    </div>

                    <div class="card-body">

                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                Nom d'utilisateur
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                value="{{ app.user.username }}"
                                readonly
                            >
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                Adresse email
                            </label>

                            <input
                                type="email"
                                class="form-control"
                                value="{{ app.user.email }}"
                                readonly
                            >
                        </div>

                        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ORGANISER') %}

                            <div class="mb-3">

                                <label class="form-label fw-bold">
                                    Rôle(s)
                                </label>

                                <div>

                                    {% for role in app.user.roles %}

                                        {% if role == 'ROLE_ADMIN' %}
                                            <span class="badge bg-danger">
                                            Administrateur
                                        </span>
                                        {% elseif role == 'ROLE_ORGANISER' %}
                                            <span class="badge bg-warning text-dark">
                                            Organisateur
                                        </span>
                                        {% endif %}

                                    {% endfor %}

                                </div>

                            </div>

                        {% endif %}

                    </div>

                </div>

            </div>

        </div>

    </div>

{% endblock %}
